<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件共享设计 token（深色配色）。 -->
<resources>
    <!-- 卡片背景 -->
    <color name="widget_bg">#263238</color>
    <!-- 主文字（课名） -->
    <color name="widget_title">#FFFFFF</color>
    <!-- 次要文字（时间/地点/表头） -->
    <color name="widget_sub">#B3FFFFFF</color>
    <!-- 强调色（空态色条 / 今日列高亮） -->
    <color name="widget_accent">#7C89F0</color>
    <!-- 一周总课表：无课格子的淡色底 -->
    <color name="widget_grid_empty">#1AFFFFFF</color>
    <!-- 分隔线（1dp 高 TextView 用） -->
    <color name="widget_divider">#33FFFFFF</color>
</resources>